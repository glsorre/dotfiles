zstyle ':omz:plugins:eza' 'icons' yes

if [ -f /home/linuxbrew/.linuxbrew/bin/brew ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)";
fi

if [ -f $HOME/.antidote/antidote.zsh ]; then
    source $HOME/.antidote/antidote.zsh
    antidote load ${ZDOTDIR:-$HOME}/repo/dotfiles/zsh_plugins.txt
elif [ -f /usr/share/zsh-antidote/antidote.zsh ]; then
    source /usr/share/zsh-antidote/antidote.zsh;
    antidote load ${ZDOTDIR:-$HOME}/repo/dotfiles/zsh_plugins.txt
elif [ -f /home/linuxbrew/.linuxbrew/opt/antidote/share/antidote/antidote.zsh ]; then
    source  /home/linuxbrew/.linuxbrew/opt/antidote/share/antidote/antidote.zsh;
    antidote load ${ZDOTDIR:-$HOME}/repo/dotfiles/zsh_plugins_minimal.txt;
fi

autoload -U compinit promptinit

PATH=$HOME/bin:$HOME/.local/bin:$PATH
export VISUAL='code -w'
export PAGER='less'
export EDITOR=$(which nvim)
alias vim="$EDITOR"
alias open="open_command"

if [ -f $HOME/.zshrc_local ]; then
    source $HOME/.zshrc_local
fi
